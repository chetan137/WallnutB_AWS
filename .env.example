# ═══════════════════════════════════════════════════════════════════════════════
# Wallnut API Server — Environment Template
#
#   cp .env.example .env              # local development
#   cp .env.example .env.production   # AWS EC2 (then fill real values)
#
# ⚠️  NEVER commit .env / .env.production — they contain the DB password.
# ═══════════════════════════════════════════════════════════════════════════════


# ── Server ────────────────────────────────────────────────────────────────────
# 5000 = the port opened in the AWS Security Group (http://65.1.213.79:5000)
PORT=5000
NODE_ENV=production


# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list. Add every domain that will call this API.
# Vercel preview deploys (*.vercel.app) are matched automatically.
ALLOWED_ORIGINS=https://wallnut-omega.vercel.app,http://localhost:5173,http://localhost:3000


# ── PostgreSQL (Antraweb VM) ──────────────────────────────────────────────────
# This DB lives on the Antraweb VM where TallyPrime + tallybackend run.
# Antraweb has whitelisted this EC2's public IP (65.1.213.79) on the DB port,
# so connect DIRECTLY to the VM's public IP — no tunnel needed.
PG_HOST=CHANGE_ME_antraweb_vm_public_ip
PG_PORT=5432
PG_DATABASE=wallnut_sync
PG_USER=postgres
PG_PASSWORD=CHANGE_ME_postgres_password

# Set to true only if the VM's Postgres has SSL enabled.
PG_SSL=false

# Connection pool size. 10 is plenty for a dashboard API.
PG_POOL_MAX=10

# Fail fast if the VM is unreachable (ms) — keeps the API responsive.
PG_CONNECT_TIMEOUT_MS=10000
PG_QUERY_TIMEOUT_MS=30000


# ── Data source strategy ──────────────────────────────────────────────────────
# db    → read from PostgreSQL (PRODUCTION — what you want)
# tally → hit TallyPrime XML API directly (legacy / local dev only)
# local → serve the bundled demo dataset from data.js (offline fallback)
#
# In 'db' mode, if Postgres is unreachable the API falls back to 'local'
# so the dashboard never renders an empty screen.
DATA_SOURCE=db

# Which Tally company to serve. Leave EMPTY to auto-pick the newest
# non-historical company from the companies table (recommended).
DEFAULT_COMPANY_ID=

# How long (seconds) to cache the dashboard payload in memory.
# The VM syncs every 10 min, so 120s costs nothing and saves DB round-trips.
CACHE_TTL_SECONDS=120


# ── TallyPrime (optional) ─────────────────────────────────────────────────────
# Only used when DATA_SOURCE=tally. The AWS box cannot reach the VM's Tally
# port, so leave these as-is in production.
TALLY_HOST=http://localhost
TALLY_PORT=9000
TALLY_COMPANY_NAME=
